{
  "info": {
    "name": "ParaBank API",
    "description": "Accounts & Transactions API coverage for ParaBank practice project (JIRA ticket: API test coverage - Accounts & Transactions). Responses are XML by default. Uses the default seeded john/demo login so this works against any fresh ParaBank instance (local or CI) - all IDs are captured dynamically from responses, nothing is hardcoded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/parabank/services/bank" },
    { "key": "customerId", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "toAccountId", "value": "" },
    { "key": "transactionId", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Login (john/demo - default seeded user)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/login/john/demo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var match = pm.response.text().match(/<id>(\\d+)<\\/id>/);",
                  "pm.test(\"Response contains customer id\", function () {",
                  "    pm.expect(match).to.not.be.null;",
                  "});",
                  "if (match) {",
                  "    pm.collectionVariables.set(\"customerId\", match[1]);",
                  "    console.log(\"Captured customerId:\", match[1]);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Get Customer Accounts",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/customers/{{customerId}}/accounts"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var match = pm.response.text().match(/<id>(\\d+)<\\/id>/);",
                  "pm.test(\"Response contains at least one account\", function () {",
                  "    pm.expect(match).to.not.be.null;",
                  "});",
                  "if (match) {",
                  "    pm.collectionVariables.set(\"accountId\", match[1]);",
                  "    console.log(\"Captured accountId:\", match[1]);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Account by Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains correct account id\", function () {",
                  "    pm.expect(pm.response.text()).to.include(`<id>${pm.collectionVariables.get(\"accountId\")}</id>`);",
                  "});",
                  "pm.test(\"Response contains a type\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"<type>\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Account by Id - Invalid Id (Edge Case)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/999999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Verify how invalid account id is handled (status logged, not asserted yet)\", function () {",
                  "    console.log(\"Status for invalid account:\", pm.response.code);",
                  "    console.log(\"Body:\", pm.response.text());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/createAccount?customerId={{customerId}}&newAccountType=0&fromAccountId={{accountId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var match = pm.response.text().match(/<id>(\\d+)<\\/id>/);",
                  "pm.test(\"Response returns a new account id\", function () {",
                  "    pm.expect(match).to.not.be.null;",
                  "});",
                  "if (match) {",
                  "    pm.collectionVariables.set(\"toAccountId\", match[1]);",
                  "    console.log(\"Captured toAccountId:\", match[1]);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Deposit Funds",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/deposit?accountId={{accountId}}&amount=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response indicates success\", function () {",
                  "    pm.expect(pm.response.text().toLowerCase()).to.include(\"success\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw Funds",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/withdraw?accountId={{accountId}}&amount=50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Withdraw More Than Balance (Edge Case - overdraft bug from DB testing)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/withdraw?accountId={{toAccountId}}&amount=999999"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Log actual behavior for overdraft withdrawal\", function () {",
                  "    console.log(\"Status:\", pm.response.code);",
                  "    console.log(\"Body:\", pm.response.text());",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Transfer Funds",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/transfer?fromAccountId={{accountId}}&toAccountId={{toAccountId}}&amount=25"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transactions for Account",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains at least one transaction\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"<transaction>\");",
                  "});",
                  "var match = pm.response.text().match(/<id>(\\d+)<\\/id>/);",
                  "if (match) {",
                  "    pm.collectionVariables.set(\"transactionId\", match[1]);",
                  "    console.log(\"Captured transactionId:\", match[1]);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Transactions by Amount",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions/amount/50"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Transaction by Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/transactions/{{transactionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains correct transaction id\", function () {",
                  "    pm.expect(pm.response.text()).to.include(`<id>${pm.collectionVariables.get(\"transactionId\")}</id>`);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
